autoload -Uz vcs_info colors
colors

zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '%F{green}+%f'
zstyle ':vcs_info:git:*' unstagedstr '%F{yellow}*%f'
zstyle ':vcs_info:git:*' formats " %F{blue}(%F{magenta} %b%c%u%F{blue})%f"
zstyle ':vcs_info:git:*' actionformats " %F{blue}(%F{red}%a %b%F{blue})%f"

precmd_vcs_info() { vcs_info }
autoload -Uz add-zsh-hook
add-zsh-hook precmd precmd_vcs_info

setopt prompt_subst

PROMPT='%F{green}%n@%m%f %F{blue}%~%f$vcs_info_msg_0_ %F{white}$%f '
