# Pure Zsh file loading (zero subshells)
zsh_add_file() {
  [[ -f "$ZDOTDIR/$1" ]] && source "$ZDOTDIR/$1"
}

# Pure Zsh plugin manager using native string slicing
zsh_add_plugin() {
  local plugin_name="${1##*/}"
  local target_dir="$ZDOTDIR/plugins/$plugin_name"

  if [[ ! -d "$target_dir" ]]; then
    git clone --depth=1 "https://github.com/$1.git" "$target_dir"
  fi

  if [[ -f "$target_dir/$plugin_name.plugin.zsh" ]]; then
    source "$target_dir/$plugin_name.plugin.zsh"
  elif [[ -f "$target_dir/$plugin_name.zsh" ]]; then
    source "$target_dir/$plugin_name.zsh"
  fi
}

# Quick runners
runr() { rustc "$1" && "./${1:r}"; }
runc() {
  local target="${1:r}"
  make "$target" && "./$target"
}
runj() { javac "$1" && java "${1:r}"; }

# Yazi working directory sync
y() {
  local tmp="$(mktemp -t yazi-cwd.XXXXXX)" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(<"$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    cd "$cwd"
  fi
  rm -f -- "$tmp"
}

# Pacman cache hook
zshcache_time="$(date +%s%N)"
rehash_precmd() {
  if [[ -a /var/cache/zsh/pacman ]]; then
    local paccache_time="$(date -r /var/cache/zsh/pacman +%s%N)"
    if (( zshcache_time < paccache_time )); then
      rehash
      zshcache_time="$paccache_time"
    fi
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook -Uz precmd rehash_precmd

# ~/.config/zsh/zsh-functions

zsh_recompile() {
  echo "Cleaning old cache and dumps..."
  rm -rf "$ZSH_CACHE_DIR"/*(N) "$ZDOTDIR"/*.zwc(N) "$ZDOTDIR"/plugins/**/*.zwc(N) 2>/dev/null
  mkdir -p "$ZSH_CACHE_DIR"

  echo "Regenerating static init scripts..."
  (( $+commands[fzf] ))    && fzf --zsh > "$ZSH_CACHE_DIR/fzf.zsh"
  (( $+commands[zoxide] )) && zoxide init zsh > "$ZSH_CACHE_DIR/zoxide.zsh"
  (( $+commands[atuin] ))  && atuin init zsh > "$ZSH_CACHE_DIR/atuin.zsh"
  (( $+commands[fnm] ))    && fnm env --use-on-cd --shell zsh > "$ZSH_CACHE_DIR/fnm.zsh"

  echo "Compiling configs to .zwc bytecode..."
  for f in "$ZDOTDIR"/*.zsh(N) "$ZDOTDIR"/zsh*(N) "$ZDOTDIR"/.zshrc(N) "$ZSH_CACHE_DIR"/*.zsh(N); do
    [[ -f "$f" ]] && zcompile -R "$f" 2>/dev/null
  done

  echo "Compiling plugins..."
  # Exclude test files, docs, and test fixtures from zcompile
  for f in "$ZDOTDIR"/plugins/**/*.zsh(N); do
    if [[ "$f" != */test*/* && "$f" != */spec/* && -f "$f" ]]; then
      zcompile -R "$f" 2>/dev/null
    fi
  done

  echo "Done! Restart your shell or run: exec zsh"
}
